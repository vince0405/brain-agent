# ============================================================================
# BRAIN AGENT - PRODUCTION CONFIGURATION
# Copy this file to .env and configure your preferred LLM provider
# ============================================================================

# --- Server & Security ---
APP_NAME="Brain Production Agent"
APP_ENV="development"          # development | staging | production
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"

# API Key Authentication (leave empty in development to allow unauthenticated local access,
# or set one or more comma-separated keys for production enforcement)
BRAIN_API_KEYS=""
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS="*"

# --- LLM Provider Configuration ---
# Supported providers: "openai" | "gemini" | "anthropic" | "ollama" | "auto"
# "auto" automatically picks the first provider with a valid API key configured,
# or falls back to the built-in local reasoning engine so the server always works.
LLM_PROVIDER="auto"

# OpenAI / OpenAI-Compatible (vLLM, Groq, OpenRouter, Together, DeepSeek)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# Anthropic Claude
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# Ollama (Local LLM)
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="llama3.2"

# --- Agent & Memory Behaviour ---
MAX_TOOL_ITERATIONS=6
SESSION_HISTORY_LIMIT=20
AUTO_EXTRACT_MEMORIES=true
RAG_TOP_K=4
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100

# --- Persistence ---
DATA_DIR="./data"
DATABASE_PATH="./data/brain.db"

